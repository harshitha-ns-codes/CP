#include <bits/stdc++.h>
using namespace std;
 
int main()
{
    string t;
    cin >> t;
    for(int i = 0; i<t.length();i++)
    {
        int digit = t[i] - '0';
        int inv = 9 - digit ;
        
        if(i == 0 && inv == 0)
            continue;
            
        if(inv < digit)
            t[i] = inv + '0';
            
    }
    
    cout << t;
    
    return 0;
}
